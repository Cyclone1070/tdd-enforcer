{
	"name": "tdd-enforcer",
	"version": "0.6.0",
	"type": "module",
	"description": "TDD enforcer plugin — enforces Red-Green phases with file access restrictions and transition gates, for the pi coding agent and the DeepSeek Harness",
	"license": "MIT",
	"author": "Cyclone1070 <hoangmai1070@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Cyclone1070/tdd-enforcer.git"
	},
	"bugs": {
		"url": "https://github.com/Cyclone1070/tdd-enforcer/issues"
	},
	"homepage": "https://github.com/Cyclone1070/tdd-enforcer#readme",
	"main": "./dist/dsh/plugin.js",
	"files": [
		"dist",
		"adapters",
		"engine",
		"skills",
		"cordis.patch.yml",
		"README.md"
	],
	"scripts": {
		"build": "node scripts/build-dsh.mjs",
		"prepare": "npm run build",
		"preflight": "node scripts/preflight-dsh.mjs",
		"check": "biome check --write . && vitest run",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run"
	},
	"keywords": [
		"pi-package",
		"dsh-plugin"
	],
	"dependencies": {
		"picomatch": "^4.0.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@earendil-works/pi-coding-agent": "^0.79.6",
		"@types/node": "^25.9.3",
		"esbuild": "^0.27.7",
		"typebox": "^1.2.16",
		"vitest": "^3"
	},
	"pi": {
		"extensions": [
			"./adapters/pi/index.ts"
		],
		"skills": [
			"./skills"
		]
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		}
	}
}
